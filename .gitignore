secrets.json

# کش تولید هنر (تصویر خام مدل؛ بازتولیدشدنی)
tools/art_gen/cache/
tools/art_gen/logs/ledger.json

# هنر ایمپورت‌شده (tools/import_art.py). منبع یکتا `art_drop/` است که خودش در
