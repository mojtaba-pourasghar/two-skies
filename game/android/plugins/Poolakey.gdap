; افزونهٔ پولاکی (پرداخت کافه بازار) — docs/02_godot_spec.md §۱۵
;
; پلاگین متن‌باز godot-poolakey با مجوز MIT. این فایل فقط قرارداد است؛ AAR باید
; از همان پروژه ساخته و اینجا گذاشته شود.
;
; کلید RSA بازار **هرگز** در مخزن نمی‌رود و فقط به محصول نهایی وصل می‌شود
; (§۱۵: «کلید RSA بازار را فقط به محصول نهایی وصل کنید»).
;
; کد بازی با `Engine.has_singleton("Poolakey")` نگهبانی می‌کند، پس بدون AAR
; فروشگاه پیام «بازار در دسترس نیست» می‌دهد و خطا نمی‌دهد.

[config]

name="Poolakey"
binary_type="local"
binary="Poolakey.aar"

[dependencies]

local=[]
remote=[]
custom_maven_repos=[]
