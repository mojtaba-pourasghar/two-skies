; دو آسمان (Two Skies) — پروژهٔ Godot
; مشخصات از docs/02_godot_spec.md §۱ گرفته شده است.

config_version=5

[application]

config/name="دو آسمان"
config/name_localized={
"en": "Two Skies"
}
config/description="پلتفرمر معمایی دو شخصیتی — ایلارا و کایرو"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
Settings="*res://autoload/settings.gd"
Audio="*res://autoload/audio.gd"
Ads="*res://autoload/ads.gd"
Billing="*res://autoload/billing.gd"
NetService="*res://autoload/net_service.gd"
SceneRouter="*res://autoload/scene_router.gd"
EventBus="*res://autoload/event_bus.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation="landscape"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/test="fa"
rendering/root_node_layout_direction=2

[layer_names]

2d_physics/layer_1="ground"
2d_physics/layer_2="kairo"
2d_physics/layer_3="ilara"
2d_physics/layer_4="enemy"
2d_physics/layer_5="hazard"
2d_physics/layer_6="item"
2d_physics/layer_7="trigger"
2d_physics/layer_8="tool"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
2d/default_gravity=900.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0

